# โฟลเดอร์อัปโหลด: เสิร์ฟเป็นไฟล์ static เท่านั้น
# ห้ามรันสคริปต์ทุกชนิด (defense-in-depth ซ้อนกับการตรวจ mime + สุ่มชื่อไฟล์ฝั่ง PHP)

Options -Indexes -ExecCGI

<FilesMatch "(?i)\.(php|phar|phtml|phps|php[0-9]|pht|inc|cgi|pl|py|sh|asp|aspx|jsp|htaccess|env)$">
  Require all denied
</FilesMatch>

<IfModule mod_php.c>
  php_flag engine off
</IfModule>
